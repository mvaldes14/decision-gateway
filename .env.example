DG_LISTEN_ADDR=:8080
DG_DEFINITIONS_DIR=./decisions
DG_MAX_BODY_BYTES=1048576
DG_MAX_CONCURRENT=64
# Laya: self-hosted System One API. Model may stay empty for Laya routing.
DG_LAYA_BASE_URL=http://localhost:8000
DG_LAYA_API_KEY=
DG_LAYA_MODEL=

# Clef: local Ollama or https://ollama.com with an API key.
DG_CLEF_BASE_URL=http://localhost:11434
DG_CLEF_API_KEY=
DG_CLEF_MODEL=clef
# Telemetry remains disabled when no OTLP endpoint is set.
OTEL_SERVICE_NAME=decision-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_INSECURE=true
